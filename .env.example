# SHUTDOWN: QAVELIX ships in maintenance mode — every request gets HTTP 503 and no
# DB/FFmpeg/Stripe/Resend work runs — unless this is explicitly "off". Leave it unset
# (or "on") to stay offline. Set it to "off" only to run the app again locally.
# QAVELIX_MAINTENANCE=off

NODE_ENV=development

# Canonical public origin.
# Production deployments must set this explicitly and use HTTPS.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public support/contact email.
# Required for public production deployments.
NEXT_PUBLIC_SUPPORT_EMAIL=qavelixhq@gmail.com

# SaaS foundation (QAVELIX PRO). Optional everywhere for now, including production —
# nothing existing depends on these yet, only the not-yet-linked /api/auth/* route.
# Set both once QAVELIX PRO auth actually goes live.
# Neon PostgreSQL connection string (Drizzle ORM).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Random secret used to sign Better Auth sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# BETTER_AUTH_SECRET=

# Real transactional email for password reset / email verification. Optional — without
# both set, these flows fall back to logging the link instead of sending a real email.
# Resend API key (https://resend.com), test-mode or production.
# RESEND_API_KEY=
# Verified sender address, e.g. "QAVELIX <noreply@qavelix.com>".
# EMAIL_FROM_ADDRESS=

# Stripe billing (QAVELIX PRO subscriptions). Optional everywhere, including production —
# with any one unset, checkout/billing-portal/webhook are simply unreachable and every
# other route keeps working exactly as without billing. All three must be set together
# (or all left unset) — see docs/DEPLOYMENT.md for the full live-launch checklist.
# Secret key — sk_test_... locally, sk_live_... only once genuinely going live.
# STRIPE_SECRET_KEY=
# Webhook signing secret for the endpoint at /api/auth/stripe/webhook — `stripe listen`
# prints a test-mode one locally; the Stripe Dashboard prints a separate one for the real
# production endpoint.
# STRIPE_WEBHOOK_SECRET=
# The recurring monthly Price ID for QAVELIX PRO (US$9.99/mo) — test-mode and live-mode
# prices are separate objects with separate IDs; never reuse one across modes.
# STRIPE_PRO_MONTHLY_PRICE_ID=
